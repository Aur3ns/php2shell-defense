<group name="php2shell,webserver,">
  <rule id="100510" level="10">
    <if_group>audit</if_group>
    <field name="audit.exe" type="pcre2">/(sh|bash|dash|curl|wget|nc|ncat|socat)$</field>
    <field name="audit.euid" type="pcre2">^(33|48|99)$</field>
    <description>Web-service UID ran a shell or download tool (heuristic)</description>
  </rule>
  <rule id="100511" level="6">
    <if_sid>31420</if_sid>
    <match>Allowed memory size of</match>
    <description>PHP memory exhaustion: investigate correlation</description>
  </rule>
</group>